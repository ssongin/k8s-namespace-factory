{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Kubernetes Namespace Factory host variables",
  "description": "Validates the host_vars structure consumed by apply.yml and the supported Ansible roles.",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": ["present", "absent"]
    },
    "configurationItem": {
      "type": "object",
      "properties": {
        "owner": { "type": "string" },
        "environment": { "type": "string" },
        "serviceOffering": { "type": "string" },
        "serviceOfferingId": { "type": "string" },
        "serviceComponent": { "type": "string" },
        "serviceComponentId": { "type": "string" },
        "description": { "type": "string" },
        "costCenterCode": { "type": "string" },
        "criticalityClass": { "type": "string" }
      },
      "required": [
        "owner",
        "environment",
        "serviceOffering",
        "serviceOfferingId",
        "serviceComponent",
        "serviceComponentId"
      ],
      "additionalProperties": true
    },
    "namespace": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "annotations": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "resources": { "$ref": "#/definitions/resourcePolicy" }
      },
      "required": ["name"],
      "additionalProperties": true
    },
    "container": {
      "type": "object",
      "properties": {
        "resources": { "$ref": "#/definitions/resourcePolicy" }
      },
      "additionalProperties": true
    },
    "externalSecrets": {
      "type": "object",
      "properties": {
        "clusterSecretStore": {
          "type": "object",
          "properties": {
            "name": { "type": "string" }
          },
          "additionalProperties": true
        },
        "refreshInterval": { "type": "string" },
        "secrets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "refreshInterval": { "type": "string" },
              "target": {
                "type": "object",
                "properties": {
                  "creationPolicy": { "type": "string" }
                },
                "additionalProperties": true
              },
              "data": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "secretKey": { "type": "string" },
                    "remoteRef": {
                      "type": "object",
                      "properties": {
                        "key": { "type": "string" },
                        "property": { "type": "string" }
                      },
                      "additionalProperties": true
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "required": ["name"],
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "configMaps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "values": {
            "type": "object",
            "additionalProperties": true
          },
          "valuesFromFile": {
            "type": "object",
            "additionalProperties": { "type": "string" }
          }
        },
        "required": ["name"],
        "additionalProperties": true
      }
    },
    "httpRoutes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "gateway": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "namespace": { "type": "string" }
            },
            "additionalProperties": true
          },
          "hostnames": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rules": {
            "type": "array",
            "items": { "type": "object" }
          }
        },
        "required": ["name", "hostnames", "rules"],
        "additionalProperties": true
      }
    },
    "dns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "record": {
            "type": "object",
            "properties": {
              "name": { "type": "string" },
              "type": { "type": "string" },
              "targets": {
                "type": ["array", "string"],
                "items": { "type": "string" }
              },
              "ttl": { "type": ["integer", "string"] },
              "providerSpecific": {
                "type": ["array", "string"],
                "items": {
                  "type": "object",
                  "properties": {
                    "name": { "type": "string" },
                    "value": { "type": "string" }
                  },
                  "additionalProperties": true
                }
              }
            },
            "required": ["name", "type", "targets"],
            "additionalProperties": true
          }
        },
        "required": ["name", "record"],
        "additionalProperties": true
      }
    },
    "localDefaults": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "namespace": { "type": "object" }
        },
        "required": ["namespace"]
      },
      "then": {
        "required": ["state", "configurationItem", "namespace"]
      }
    }
  ],
  "additionalProperties": true,
  "definitions": {
    "resourcePolicy": {
      "type": "object",
      "properties": {
        "requests": { "$ref": "#/definitions/resourceValues" },
        "limits": { "$ref": "#/definitions/resourceValues" }
      },
      "additionalProperties": true
    },
    "resourceValues": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "cpu": { "type": "string" },
        "memory": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}
